<Window x:Class="WPFPlateModel.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:hx="http://helix-toolkit.org/wpf/SharpDX"
        xmlns:local="clr-namespace:WPFPlateModel.ViewModels"
        xmlns:i="http://schemas.microsoft.com/xaml/behaviors"
        mc:Ignorable="d"
        Title="MainWindow" UseLayoutRounding="True">
    
    <Window.Resources>
        <ResourceDictionary Source="/Resources/MainStyles.xaml"/>
    </Window.Resources>
    <Window.CommandBindings>
        <CommandBinding Command="ApplicationCommands.Save"/>
    </Window.CommandBindings>
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="9*"/>
            <ColumnDefinition Width="11*"/>
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="18"/>
            <RowDefinition/>
        </Grid.RowDefinitions>
        <Menu VerticalAlignment="Center" Grid.ColumnSpan="2" 
               FontSize="12">
            <MenuItem Header="File">
                <MenuItem Command ="ApplicationCommands.Save"/>

            </MenuItem>
        </Menu>
        <Grid Grid.Row="1" Grid.ColumnSpan="2">
            <hx:Viewport3DX x:Name="firstView"
                BackgroundColor="{DynamicResource BorderLightColor}"
                Camera="{Binding Camera}"
                EffectsManager="{Binding EffectsManager}"
                ModelUpDirection="{Binding UpDirection}"
                ShowViewCube="False">
                <hx:Viewport3DX.InputBindings>
                    <MouseBinding Command="hx:ViewportCommands.Rotate"
                              Gesture="LeftClick" />
                    <MouseBinding Command="hx:ViewportCommands.Zoom"
                              Gesture="RightClick" />
                    <MouseBinding Command="hx:ViewportCommands.Pan"
                                   Gesture="MiddleClick"/>
                </hx:Viewport3DX.InputBindings>
                <hx:AmbientLight3D Color="#404040"/>
                <hx:DirectionalLight3D Direction="{Binding Camera.LookDirection}" Color="White"/>
                <hx:LineMaterialGeometryModel3D Geometry="{Binding AxisModel}"
                                        Material="{Binding AxisModelMaterial}"/>
                <hx:MeshGeometryModel3D Geometry="{Binding Model}"  
                                        Material="{Binding ModelMaterial}"
                                        RenderWireframe="False"
                                        CullMode="Back"
                                        Transform="{Binding ModelTransform}"/>
            </hx:Viewport3DX>
        </Grid>
    </Grid>
</Window>
